{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soc-image.reuse-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hardware_ir_sha256", "software_requirements_sha256", "source_policy_sha256", "source_candidates_sha256", "anchor", "entries", "adapter_tasks", "uncovered", "coherence"],
  "properties": {
    "schema": {"const": "soc-image.reuse-plan.v1"},
    "hardware_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software_requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_candidates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor": {"type": ["string", "null"], "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "disposition", "candidate_ids", "source_paths", "strategy", "basis"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9,._+@:-]+$"},
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {"enum": ["role", "component"]},
              "id": {"type": "string", "minLength": 1}
            }
          },
          "disposition": {"enum": ["reuse", "generate", "reference", "blocked"]},
          "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "strategy": {"enum": ["direct", "configure", "adapt", "rewrite", "reference", "blocked"]},
          "basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "allOf": [
          {"if": {"properties": {"disposition": {"const": "reuse"}}}, "then": {"properties": {"candidate_ids": {"minItems": 1}, "source_paths": {"minItems": 1}}}},
          {"if": {"properties": {"disposition": {"const": "generate"}}}, "then": {"properties": {"candidate_ids": {"maxItems": 0}}}},
          {"if": {"properties": {"disposition": {"const": "blocked"}}}, "then": {"properties": {"strategy": {"const": "blocked"}}}}
        ]
      }
    },
    "adapter_tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "from_candidate", "to_anchor"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9,._+@:-]+$"},
          "reason": {"type": "string", "minLength": 1},
          "from_candidate": {"type": "string", "minLength": 1},
          "to_anchor": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncovered": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "reason"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "reasons"],
      "properties": {
        "passed": {"type": "boolean"},
        "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
