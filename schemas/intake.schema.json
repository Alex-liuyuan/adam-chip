{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soc-image.intake.v1",
  "title": "Hardware-material-only SoC image intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "materials", "software_configuration_accepted"],
  "properties": {
    "schema": {"const": "soc-image.intake.v1"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$"},
    "software_configuration_accepted": {"const": false},
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "source_path", "stored_path", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["document", "image", "svd", "dts", "cmsis_pack", "unknown"]},
          "source_path": {"type": "string", "minLength": 1},
          "stored_path": {"type": "string", "pattern": "^materials/[A-Za-z0-9._-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
