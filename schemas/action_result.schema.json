{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adam.action_result.v1",
  "title": "ADAM deterministic engineering action result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "project_id", "agent", "action", "target_hash", "status", "commands", "inputs", "artifacts", "evidence", "evidence_level", "gate_errors", "handoff_ready"],
  "properties": {
    "schema": {"const": "adam.action_result.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "target_hash": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "tool": {"type": "string", "minLength": 1},
    "third_party": {"type": "array", "items": {"type": "string"}},
    "result_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed", "blocked", "skipped"]},
    "commands": {"type": "array", "items": {"type": "object"}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "evidence": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "evidence_level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6"]},
    "gate_errors": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "failure_class": {"type": ["string", "null"]},
    "failure_owner": {"type": ["string", "null"]},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "handoff_ready": {"type": "boolean"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
