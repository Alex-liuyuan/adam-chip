{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sysuos.sdk.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "version", "source_context_lock", "source_context_lock_sha256", "source_layers", "components", "provider_contracts"],
  "properties": {
    "schema": {"const": "sysuos.sdk.v1"},
    "name": {"const": "SYSUOS source adaptation kit"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_context_lock": {"const": "source-context.lock.json"},
    "source_context_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_layers": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/source"}},
    "components": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^core/[a-z_]+/component\\.json$"}},
    "provider_contracts": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"enum": ["boot", "device", "media", "accelerator", "image"]}}
  },
  "$defs": {
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "source", "version"],
      "properties": {
        "id": {"enum": ["micropython", "sysu_compat", "rt_ai", "compiler_runtime"]},
        "kind": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1},
        "source": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["source_context"], "properties": {"source_context": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["project_source"], "properties": {"project_source": {"type": "object", "additionalProperties": false, "required": ["revision", "project_path", "content_hash"], "properties": {"revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "project_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}}
        ]}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "repository", "revision", "content_hash", "selected_paths", "source_usage", "redistribution"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_hash": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256-git-ls-tree-v1"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        "selected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "source_usage": {"enum": ["target", "build_tool", "verification_tool", "reference_only"]},
        "redistribution": {"type": "string", "minLength": 1}
      }
    }
  }
}
