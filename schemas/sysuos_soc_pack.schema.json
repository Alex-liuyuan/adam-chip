{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sysuos.soc-pack.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "soc", "board", "hardware_materials", "reference_image", "adaptation_plan", "providers", "sources", "patches", "tests", "blockers"],
  "properties": {
    "schema": {"const": "sysuos.soc-pack.v1"},
    "soc": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "board": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "hardware_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "stored_path", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "stored_path": {"$ref": "#/$defs/path"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "reference_image": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/referenceImage"}]},
    "adaptation_plan": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"},
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boot", "device", "media", "accelerator", "image"],
      "properties": {
        "boot": {"$ref": "#/$defs/provider"},
        "device": {"$ref": "#/$defs/provider"},
        "media": {"$ref": "#/$defs/provider"},
        "accelerator": {"$ref": "#/$defs/provider"},
        "image": {"$ref": "#/$defs/provider"}
      }
    },
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "patches": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/path"}},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "replacement_required", "implementation"],
      "properties": {
        "contract": {"type": "string", "pattern": "^contracts/[a-z]+_provider\\.schema\\.json$"},
        "replacement_required": {"const": true},
        "implementation": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"}]}
      }
    },
    "referenceImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "bytes", "observations"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "observations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "revision", "content_hash", "selected_paths"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"const": "sha256-git-ls-tree-v1"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "selected_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}
      }
    }
  }
}
