{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soc-image.engineering-agent-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "attempt_id",
    "agent",
    "hardware_ir_sha256",
    "input_hash",
    "round",
    "status",
    "summary",
    "inspected_paths",
    "reused_sources",
    "changes",
    "commands",
    "blockers"
  ],
  "properties": {
    "schema": {"type": "string", "const": "soc-image.engineering-agent-report.v1"},
    "task_id": {"type": "string", "pattern": "^task:[a-z][a-z0-9_-]*$"},
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "agent": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*Agent$"},
    "hardware_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "status": {"type": "string", "enum": ["implemented", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "inspected_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reused_sources": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "changes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
