{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soc-image.source-lock.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hardware_ir_sha256", "reference_profile_sha256", "software_requirements_sha256", "source_policy_sha256", "source_candidates_sha256", "reuse_plan_sha256", "build", "build_tools", "verification_tools", "internal_evaluation", "reference_only", "reference_stacks", "dependency_edges"],
  "properties": {
    "schema": {"const": "soc-image.source-lock.v3"},
    "hardware_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "software_requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_candidates_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reuse_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "build_tools": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "verification_tools": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "internal_evaluation": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "reference_only": {"type": "array", "items": {"$ref": "#/$defs/repository"}},
    "reference_stacks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "workspace", "manifest_path", "manifest_sha256", "root_repository_id", "repositories"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["internal_evaluation", "reference_only"]},
          "workspace": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "manifest_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "root_repository_id": {"type": "string", "minLength": 1},
          "repositories": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["repository_id", "path"],
              "properties": {
                "repository_id": {"type": "string", "minLength": 1},
                "path": {"type": "string", "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+)$"}
              }
            }
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent_id", "child_id", "kind", "path", "declaration_path", "declaration_sha256", "revision"],
        "properties": {
          "parent_id": {"type": "string", "minLength": 1},
          "child_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["git_submodule", "repo_manifest"]},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "declaration_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "revision", "content_hash", "license", "license_evidence", "license_evidence_status", "selected_paths", "covered_requirements"],
      "allOf": [
        {"if": {"properties": {"license_evidence_status": {"const": "found"}}}, "then": {"properties": {"license_evidence": {"minItems": 1}}}},
        {"if": {"properties": {"license_evidence_status": {"const": "not_found"}}}, "then": {"properties": {"license_evidence": {"maxItems": 0}}}}
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "url": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": {"const": "sha256-git-ls-tree-v1"},
            "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "license": {"type": "string", "minLength": 1},
        "license_evidence": {"type": "array", "items": {"$ref": "#/$defs/fileEvidence"}},
        "license_evidence_status": {"enum": ["found", "not_found"]},
        "selected_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}},
        "covered_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
