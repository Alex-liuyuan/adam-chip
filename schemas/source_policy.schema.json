{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "soc-image.source-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mandatory_roles", "build_licenses", "candidates", "reference_stacks"],
  "properties": {
    "schema": {"const": "soc-image.source-policy.v1"},
    "mandatory_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "build_licenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference_stacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "selectors", "workspace", "manifest", "expected_repositories"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "decision": {"enum": ["internal_evaluation", "reference_only"]},
          "selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "workspace": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "manifest": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "expected_repositories": {"type": "integer", "minimum": 1}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "roles", "selectors", "license", "license_files", "sparse_paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "url": {"type": "string", "pattern": "^https://"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "license": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["build", "internal_evaluation", "reference_only"]},
          "source_usage": {"enum": ["target", "build_tool", "verification_tool", "reference_only"]},
          "companion_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}},
          "os_abi": {"type": "string", "minLength": 1},
          "media_abi": {"type": "string", "minLength": 1},
          "license_files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "sparse_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
