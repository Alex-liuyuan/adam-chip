{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADAM boot contract",
  "type": "object",
  "required": ["schema", "target", "type"],
  "properties": {
    "schema": {"type": "string"},
    "target": {"type": "string"},
    "type": {"type": "string"},
    "build": {
      "type": "object",
      "required": ["backend", "source", "source_revision", "defconfig", "artifacts"],
      "properties": {
        "backend": {"type": "string"},
        "source": {"type": "string"},
        "source_revision": {"type": "string", "minLength": 40},
        "arch": {"type": "string"},
        "defconfig": {"type": "string"},
        "cross_compile_required": {"type": "boolean"},
        "python_modules": {"type": "array", "items": {"type": "string"}},
        "required_config": {"type": "array", "items": {"type": "string"}},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "path"],
            "properties": {
              "name": {"type": "string"},
              "path": {"type": "string"},
              "min_bytes": {"type": "integer", "minimum": 1},
              "magic_ascii": {"type": "string"}
            }
          }
        },
        "symbol_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact", "required"],
            "properties": {
              "artifact": {"type": "string"},
              "required": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "required_components": {"type": "array"},
    "required_evidence": {"type": "array"},
    "not_claimed": {"type": "array"}
  },
  "additionalProperties": true
}
